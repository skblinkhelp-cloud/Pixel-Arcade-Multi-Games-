<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HARD Shadow -->
    <item android:top="8dp" android:left="8dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arcade_dark" />
        </shape>
    </item>
    <!-- Main Box -->
    <item android:top="0dp" android:left="0dp" android:bottom="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/arcade_cream" />
            <stroke android:width="4dp" android:color="@color/arcade_dark" />
        </shape>
    </item>
</layer-list>