<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Piche wali Solid Black Shadow (Jo button ko pixel block look deti hai) -->
    <item android:top="6dp" android:left="6dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Layer (Foreground) -->
    <item android:top="0dp" android:left="0dp" android:bottom="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="3dp" android:color="#000000" />
        </shape>
    </item>
</layer-list>