<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img_2739"
    android:padding="12dp"
    android:gravity="center_horizontal"
    tools:context=".JumpQuestActivity">

    <!-- Top Pixel Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/pixel_button_cyan"
            android:src="@drawable/btn_home"
            android:scaleType="fitCenter"
            android:contentDescription="Back"
            android:padding="8dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JUMP QUEST 2D"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Score & Lives HUD Canvas Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:background="@drawable/pixel_block_white"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCORE: 0"
            android:textColor="#166534"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLives"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIVES: ❤❤❤"
            android:textColor="#991B1B"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BEST: 0"
            android:textColor="#1E40AF"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Game View Frame Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pixel_block_white"
        android:padding="6dp">

        <com.sk.multigamearcade.JumpQuestGameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Game Over View -->
        <LinearLayout
            android:id="@+id/layoutGameOver"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="GAME OVER!"
                android:textColor="#FF5252"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="FINAL SCORE: 0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/pixel_button_green"
                android:fontFamily="monospace"
                android:text="PLAY AGAIN ↺"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Arcade Touch Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pixel_button_purple"
            android:text="◄ LEFT"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="20sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/pixel_button_cyan"
            android:text="RIGHT ►"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="20sp"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>