<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_2739">

    <!-- Splash Screen Background -->
    <ImageView
        android:id="@+id/ivSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bg" />

    <!-- Logo Placed On Top Of Splash Screen -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/desc_arcade_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/pixel_arcade_logo" />

</FrameLayout>
